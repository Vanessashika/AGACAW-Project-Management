      <div class="rg"><h3><span class="tag">O${i+1}</span>${h(o.short)}</h3>
      ${o.acts.map(a => `<div class="ri"><button class="an" type="button" data-goto="${a.id}">${h(a.name)}</button>
        <div class="rt ${a.results?"":"none"}">${a.results ? h(a.results) : "No results recorded yet"}</div></div>`).join("") || `<div class="empty">No activities.</div>`}</div>`).join("")}
    </div>
