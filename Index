function ganttHTML(){
  const acts = allActs(); if(!acts.length) return "";
  const min = new Date(Math.min(...acts.map(x=>toD(x.a.start)))); min.setDate(1); min.setMonth(Math.floor(min.getMonth()/3)*3);
  const max = new Date(Math.max(...acts.map(x=>toD(x.a.end)))); max.setMonth(Math.floor(max.getMonth()/3)*3+3, 1);
  const span = max-min, pos = d => Math.max(0,Math.min(100,(d-min)/span*100));
  const ticks = []; for(let d=new Date(min); d<max; d.setMonth(d.getMonth()+3)) ticks.push(new Date(d));
  const tpos = pos(today), showToday = today>=min && today<=max;
  const bg = ticks.map(d=>`<i class="g-grid" style="left:${pos(d)}%"></i>`).join("") + (showToday?`<i class="g-today" style="left:${tpos}%"></i>`:"");
  let html = `<div></div><div class="g-axis">${ticks.map(d=>`<span style="left:${pos(d)}%">Q${d.getMonth()/3+1} ${String(d.getFullYear()).slice(2)}</span>`).join("")}
    ${showToday?`<span class="g-todaylbl" style="left:${tpos}%">Today</span>`:""}</div>`;
  state.outcomes.forEach((o,i) => {
    html += `<div class="g-lbl oh">O${i+1} · ${h(o.short)}</div><div class="g-row">${bg}</div>`;
    o.acts.forEach(a => { const l = pos(toD(a.start)), w = Math.max(1,pos(toD(a.end))-l), p = actPct(a);
      html += `<button class="g-lbl" type="button" data-goto="${a.id}" title="${h(a.name)}">${h(a.name)}</button>
        <div class="g-row">${bg}<div class="g-bar ${actStatus(a)}" style="left:${l}%;width:${w}%" title="${h(a.name)}: ${p}% · ${fmt(a.start)} – ${fmt(a.end)}"><div class="f" style="width:${p}%"></div></div></div>` });
  });
  return html;
}

