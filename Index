<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>WASH Programme Tracker</title>
<meta name="claude:viewport-fit-sides" content="cover">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Albert+Sans:wght@300;400;500;600&family=Manrope:wght@400;500;600;700;800&family=IBM+Plex+Mono:wght@400;500;600&display=swap">
<style>
/* Layout: sticky tab bar (one tab per outcome, then Summary). Outcome tab = outcome header + two-pane activity list / activity detail. Summary tab = dashboard + schedule + results log */
:root{
  --bg:#f5f8fc; --surface:#ffffff; --sunk:#f0f4fa; --ink:#0f1e36; --muted:#5f6f88; --line:#e3e9f2;
  --accent:#1e4f8f; --accent-soft:#e6eff9;
  --done:#1e4f8f; --prog:#93b8e6; --late:#c0453a; --todo:#e4eaf3;
  --done-soft:#e6eff9; --prog-soft:#eef4fc; --late-soft:#fbeae8;
  --o1:#0f2f5c; --o2:#1e4f8f; --o3:#2f6fbf; --o4:#3a78c2; --o5:#5590d2;
  --hero:#ffffff; --hero2:#ffffff; --hero-ink:#0f1e36; --hero-muted:#5f6f88; --hero-line:#e3e9f2;
--f-display:"Albert Sans","Manrope",system-ui,sans-serif;
  --f-ui:"Manrope",system-ui,-apple-system,"Segoe UI",sans-serif;
  --f-num:"IBM Plex Mono",ui-monospace,"SFMono-Regular",Menlo,monospace;
}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){
  --bg:#0a1220; --surface:#0f1a2c; --sunk:#0c1626; --ink:#e6edf7; --muted:#8ea0bb; --line:#1d2b42;
  --accent:#86b5ef; --accent-soft:#15284a;
  --done:#86b5ef; --prog:#3a5d8e; --late:#ec7c70; --todo:#1d2b42;
  --done-soft:#15284a; --prog-soft:#122340; --late-soft:#3a1c1b;
  --o1:#c3d9f6; --o2:#9cc2f1; --o3:#76a9ea; --o4:#5a92dc; --o5:#4479c4;
  --hero:#0f1a2c; --hero2:#0f1a2c; --hero-ink:#e6edf7; --hero-muted:#8ea0bb; --hero-line:#1d2b42;
  color-scheme:dark;}}
:root[data-theme="dark"]{
  --bg:#0a1220; --surface:#0f1a2c; --sunk:#0c1626; --ink:#e6edf7; --muted:#8ea0bb; --line:#1d2b42;
  --accent:#86b5ef; --accent-soft:#15284a;
  --done:#86b5ef; --prog:#3a5d8e; --late:#ec7c70; --todo:#1d2b42;
  --done-soft:#15284a; --prog-soft:#122340; --late-soft:#3a1c1b;
  --o1:#c3d9f6; --o2:#9cc2f1; --o3:#76a9ea; --o4:#5a92dc; --o5:#4479c4;
  --hero:#0f1a2c; --hero2:#0f1a2c; --hero-ink:#e6edf7; --hero-muted:#8ea0bb; --hero-line:#1d2b42;
  color-scheme:dark;}

*{box-sizing:border-box}
[hidden]{display:none!important}
body{background:var(--bg);color:var(--ink);font-family:var(--f-ui);font-size:14px;line-height:1.5}
body::before{content:"";position:fixed;inset:0 0 auto;height:env(safe-area-inset-top,0px);z-index:10;background:var(--surface)}
.pad{padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px))}
.inner{max-width:1180px;margin:0 auto}
h1,h2,h3{margin:0;text-wrap:balance}
.num{font-family:var(--f-num);font-variant-numeric:tabular-nums}
button,select,input,textarea{font:inherit;color:inherit}
button{cursor:pointer}
:focus-visible{outline:2px solid var(--accent);outline-offset:2px}

/* Header */
.masthead{background:var(--surface);padding-block:18px 0}
.top{display:flex;flex-wrap:wrap;gap:12px 16px;align-items:flex-end;justify-content:space-between}
.eyebrow{font-size:11px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--accent)}
h1{font-family:var(--f-display);font-size:24px;font-weight:800;letter-spacing:-.02em;line-height:1.15}
.sub{color:var(--muted);font-size:13px;margin-top:2px}
.actions{display:flex;flex-wrap:wrap;gap:8px}
.btn{border:1px solid var(--line);background:var(--surface);border-radius:8px;padding:7px 12px;font-weight:600;font-size:13px}
.btn:hover{border-color:var(--accent);color:var(--accent)}
.btn.primary{background:var(--accent);border-color:var(--accent);color:var(--surface)}
.btn.primary:hover{opacity:.9;color:var(--surface)}
.btn.warn{border-color:var(--late);color:var(--late)}
.btn.ghost{border-style:dashed}

/* Tabs */
.tabbar{position:sticky;top:env(safe-area-inset-top,0px);z-index:5;background:var(--surface);border-bottom:1px solid var(--line)}
.tabs{display:flex;gap:4px;overflow-x:auto;scrollbar-width:thin;padding-top:14px}
.tab{flex:none;border:0;background:none;padding:9px 14px 11px;border-bottom:3px solid transparent;display:flex;flex-direction:column;align-items:flex-start;gap:1px;text-align:left;min-width:120px;color:var(--muted)}
.tab .tk{font-size:10.5px;font-weight:700;letter-spacing:.1em;text-transform:uppercase}
.tab .tl{font-size:13.5px;font-weight:700;color:var(--ink);white-space:nowrap}
.tab .tp{display:flex;align-items:center;gap:6px;font-family:var(--f-num);font-size:11.5px;width:100%}
.tab .mini{flex:1;height:4px;border-radius:2px;background:var(--todo);overflow:hidden;min-width:40px}
.tab .mini i{display:block;height:100%;background:var(--accent)}
.tab:hover .tl{color:var(--accent)}
.tab[aria-selected="true"]{border-bottom-color:var(--oc,var(--accent));color:var(--oc,var(--accent))}
.tab .mini i{background:var(--oc,var(--accent))}
.tab.home{min-width:0;justify-content:center;padding-inline:16px}
.tab.home .tl{display:flex;align-items:center;gap:7px}
.tab.sum{margin-left:auto;border-left:1px solid var(--line);padding-left:18px}

main{padding-block:20px 64px}
.view{display:flex;flex-direction:column;gap:18px}
.note{background:var(--prog-soft);border:1px solid color-mix(in srgb,var(--prog) 35%,transparent);border-radius:10px;padding:10px 14px;font-size:13px;display:flex;flex-wrap:wrap;gap:8px;align-items:center;justify-content:space-between}
.toast{position:fixed;left:50%;transform:translateX(-50%);bottom:calc(20px + env(safe-area-inset-bottom,0px));background:var(--ink);color:var(--bg);padding:9px 16px;border-radius:8px;font-weight:600;font-size:13px;z-index:20;max-width:calc(100% - 32px)}

.panel{background:var(--surface);border:1px solid var(--line);border-radius:12px;padding:18px 20px;min-width:0}
.panel h2{font-family:var(--f-display);font-size:16px;font-weight:700}
.ph{display:flex;justify-content:space-between;align-items:baseline;gap:12px;margin-bottom:14px;flex-wrap:wrap}
.hint{color:var(--muted);font-size:12px}
.empty{color:var(--muted);font-size:13px;padding:8px 0}
.bar{height:10px;background:var(--todo);border-radius:5px;overflow:hidden;display:flex}
.bar .d{background:var(--done)} .bar .p{background:var(--prog)}
.dot{width:8px;height:8px;border-radius:50%;flex:none;display:inline-block}
.st{font-size:11.5px;font-weight:700;padding:3px 9px;border-radius:999px;white-space:nowrap}
.st.done{background:var(--done-soft);color:var(--done)}
.st.prog{background:var(--prog-soft);color:var(--prog)}
.st.todo{background:var(--sunk);color:var(--muted);border:1px solid var(--line)}
.st.late{background:var(--late-soft);color:var(--late)}

/* Outcome header */
.ohead{border-top:4px solid var(--oc,var(--accent))}
.ohead .eyebrow{color:var(--oc,var(--accent))}
.item.open{border-color:color-mix(in srgb,var(--oc,var(--accent)) 55%,var(--line))}
.item.open .chev{background:color-mix(in srgb,var(--oc,var(--accent)) 16%,var(--surface));color:var(--oc,var(--accent))}

/* Home */
body.is-home main{padding-block:28px 56px}
body.is-home::before{background:var(--bg)}
.hbtns{display:flex;flex-wrap:wrap;gap:10px;margin-top:22px}
.hbtn{border:1px solid var(--hero-line);background:transparent;color:var(--hero-ink);border-radius:9px;padding:9px 16px;font-weight:700;font-size:13.5px}
.hbtn:hover{background:var(--hero-line)}
.hbtn.solid{background:var(--hero-ink);color:var(--hero);border-color:var(--hero-ink)}
.hbtn.solid:hover{opacity:.92;background:var(--hero-ink)}
.hnote{font-size:12.5px;color:var(--muted);text-align:center}
.hnote button{border:0;background:none;padding:0;color:var(--accent);font-weight:700;font-size:inherit}
.hero{position:relative;overflow:hidden;border-radius:16px;background:linear-gradient(135deg,var(--hero),var(--hero2));color:var(--hero-ink);padding:34px 34px 30px;display:grid;grid-template-columns:minmax(0,1fr) auto;gap:24px 40px;align-items:center}
.hero .waves{position:absolute;inset:auto 0 0 0;width:100%;height:120px;pointer-events:none}
.hero .waves path{fill:none;stroke:var(--hero-line);stroke-width:1.5}
.hero>*:not(.waves){position:relative}
.hero .kick{font-size:11.5px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--hero-muted)}
.hero h2{font-family:var(--f-display);font-size:clamp(28px,4.4vw,46px);font-weight:800;line-height:1.04;letter-spacing:-.03em;margin:8px 0 12px;max-width:16ch}
.hero p{margin:0;color:var(--hero-muted);max-width:52ch;font-size:14.5px}
.places{display:flex;flex-wrap:wrap;gap:6px;margin-top:16px}
.places span{border:1px solid var(--hero-line);border-radius:999px;padding:3px 11px;font-size:12px;font-weight:600;color:var(--hero-ink)}
.hstat{display:flex;flex-direction:column;align-items:center;gap:10px}
.hstat .ring text{fill:var(--hero-ink)}
.hfig{display:grid;grid-template-columns:repeat(3,auto);gap:4px 20px;text-align:center}
.hfig b{font-family:var(--f-num);font-size:20px;font-weight:600;display:block;line-height:1.1}
.hfig span{font-size:11.5px;color:var(--hero-muted)}
@media (max-width:720px){.hero{grid-template-columns:1fr;padding:26px 22px}.hstat{flex-direction:row;justify-content:flex-start;flex-wrap:wrap}}
.shead{display:flex;justify-content:space-between;align-items:baseline;gap:12px;flex-wrap:wrap;margin-top:6px}
.shead h2{font-family:var(--f-display);font-size:20px;font-weight:700;letter-spacing:-.01em}
.cards{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:14px}
@media (max-width:1100px){.cards{grid-template-columns:repeat(3,minmax(0,1fr))}}
@media (max-width:760px){.cards{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media (max-width:480px){.cards{grid-template-columns:1fr}}
.ocard{--oc:var(--accent);position:relative;text-align:left;border:1px solid var(--line);background:var(--surface);border-radius:14px;padding:18px 18px 16px;display:flex;flex-direction:column;gap:12px;min-width:0;overflow:hidden}
.ocard::before{content:"";position:absolute;inset:0 0 auto 0;height:5px;background:var(--oc)}
.ocard:hover{border-color:color-mix(in srgb,var(--oc) 55%,var(--line))}
@media (prefers-reduced-motion:no-preference){.ocard{transition:transform .18s ease,border-color .18s ease}.ocard:hover{transform:translateY(-3px)}}
.ocard .top2{display:flex;justify-content:space-between;align-items:flex-start;gap:8px}
.ocard .big{font-family:var(--f-display);font-size:40px;font-weight:800;line-height:.9;color:var(--oc);letter-spacing:-.04em}
.ocard .sn{font-family:var(--f-display);font-size:17px;font-weight:700;line-height:1.2}
.ocard .fn{font-size:12.5px;color:var(--muted);line-height:1.45;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden;height:4.35em}
.ocard .pr{display:flex;align-items:center;gap:10px}
.ocard .pr .track{flex:1;height:8px;border-radius:4px;background:var(--todo);overflow:hidden}
.ocard .pr .track i{display:block;height:100%;background:var(--oc)}
.ocard .pr b{font-family:var(--f-num);font-size:15px}
.ocard .facts{display:flex;justify-content:space-between;gap:8px;font-size:12px;color:var(--muted);border-top:1px solid var(--line);padding-top:10px}
.ocard .facts .lt{color:var(--late);font-weight:700}
.ocard .open{font-size:12.5px;font-weight:700;color:var(--oc)}
.home2 .duelist{max-height:none}
.home2{display:grid;grid-template-columns:minmax(0,1.4fr) minmax(0,1fr);gap:16px}
@media (max-width:860px){.home2{grid-template-columns:1fr}}
.recent{display:flex;flex-direction:column;gap:10px}
.rc{border:0;background:none;padding:0;text-align:left;display:grid;grid-template-columns:4px minmax(0,1fr);gap:12px}
.rc i{border-radius:2px;background:var(--oc)}
.rc b{display:block;font-size:13px}
.rc span{font-size:13px;color:var(--muted);display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.rc:hover b{color:var(--accent)}

.ohead{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:14px 24px;align-items:end}
.ohead h2{font-family:var(--f-display);font-size:23px;font-weight:700;letter-spacing:-.01em;line-height:1.25;max-width:60ch}
.ostats{display:flex;gap:22px;flex-wrap:wrap}
.ostat{display:flex;flex-direction:column}
.ostat .v{font-family:var(--f-num);font-size:22px;font-weight:600;line-height:1.1}
.ostat .k{font-size:12px;color:var(--muted)}
.ohead .bar{grid-column:1/-1}
@media (max-width:700px){.ohead{grid-template-columns:1fr}}

/* Accordion */
.acc{display:flex;flex-direction:column;gap:8px}
.item{scroll-margin-top:100px;background:var(--surface);border:1px solid var(--line);border-radius:10px;min-width:0}
.item.open{border-color:color-mix(in srgb,var(--accent) 55%,var(--line));box-shadow:0 1px 0 var(--line)}
.ihead{width:100%;border:0;background:none;text-align:left;padding:13px 16px;display:grid;grid-template-columns:22px minmax(0,1fr) 160px 46px 112px;gap:4px 14px;align-items:center;border-radius:10px}
.ihead:hover .in{color:var(--accent)}
.chev{width:22px;height:22px;border-radius:6px;display:grid;place-items:center;background:var(--sunk);color:var(--muted);transition:transform .2s ease}
.item.open .chev{transform:rotate(90deg);background:var(--accent-soft);color:var(--accent)}
.in{font-weight:700;font-size:14px;line-height:1.35}
.im{font-size:12px;color:var(--muted)}
.ip{font-family:var(--f-num);font-weight:600;text-align:right}
.ihead .st{justify-self:end}
@media (max-width:720px){
  .ihead{grid-template-columns:22px minmax(0,1fr) auto}
  .ihead .bar{grid-column:2/4;grid-row:2}
  .ihead .ip{grid-column:3;grid-row:1}
  .ihead .st{grid-column:2/4;grid-row:3;justify-self:start}
}
.ibody{border-top:1px solid var(--line);padding:16px;display:flex;flex-direction:column;gap:14px;background:var(--sunk);border-radius:0 0 10px 10px}
details.sub{border:1px solid var(--line);border-radius:8px;background:var(--surface)}
details.sub>summary{cursor:pointer;padding:9px 12px;font-size:12px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);display:flex;justify-content:space-between;gap:10px}
details.sub>summary span{letter-spacing:0;text-transform:none;font-weight:500}
details.sub[open]>summary{border-bottom:1px solid var(--line)}
details.sub>.subin{padding:12px;display:flex;flex-direction:column;gap:12px}
.accbar{display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap}

/* Two-pane */
.split{display:grid;grid-template-columns:330px minmax(0,1fr);gap:16px;align-items:start}
@media (max-width:860px){.split{grid-template-columns:1fr}}
.alist{display:flex;flex-direction:column;gap:6px;position:sticky;top:calc(env(safe-area-inset-top,0px) + 92px)}
@media (max-width:860px){.alist{position:static}}
.ai{border:1px solid var(--line);background:var(--surface);border-radius:10px;padding:10px 12px;text-align:left;display:grid;grid-template-columns:minmax(0,1fr) auto;gap:6px 10px;align-items:center;width:100%}
.ai:hover{border-color:color-mix(in srgb,var(--accent) 50%,var(--line))}
.ai[aria-current="true"]{border-color:var(--accent);box-shadow:inset 3px 0 0 var(--accent);background:color-mix(in srgb,var(--accent-soft) 45%,var(--surface))}
.ai .n{font-weight:700;font-size:13px;line-height:1.35}
.ai .p{font-family:var(--f-num);font-weight:600;font-size:13px}
.ai .bar{height:6px;grid-column:1/-1}
.ai .m{grid-column:1/-1;display:flex;justify-content:space-between;gap:8px;font-size:11.5px;color:var(--muted)}
.ai .m .lt{color:var(--late);font-weight:700}

.detail{display:flex;flex-direction:column;gap:16px}
.dtitle{width:100%;border:1px solid transparent;background:none;border-radius:8px;padding:4px 6px;margin:-4px -6px;font-size:18px;font-weight:800;line-height:1.3}
.dtitle:hover{border-color:var(--line)}
.dtitle:focus{border-color:var(--accent);background:var(--surface)}
.fields{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:10px 14px}
.fld{display:flex;flex-direction:column;gap:4px;font-size:12px;color:var(--muted);font-weight:600;min-width:0}
.fld input,.fld select,.fld textarea{border:1px solid var(--line);background:var(--surface);border-radius:7px;padding:7px 9px;font-size:13px;color:var(--ink);font-weight:500;min-width:0;width:100%}
.fld textarea{resize:vertical;min-height:84px;line-height:1.5}
.prow{display:flex;gap:12px;align-items:center}
.prow .bar{flex:1}
.prow .v{font-family:var(--f-num);font-weight:600}
.sec{font-size:12px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);display:flex;justify-content:space-between;gap:10px;align-items:baseline}
.sec span{letter-spacing:0;text-transform:none;font-weight:500}
.tasks{display:flex;flex-direction:column;gap:6px}
.task{display:grid;grid-template-columns:130px minmax(0,1fr) 145px auto;gap:8px;align-items:center}
.task select,.task input{border:1px solid var(--line);background:var(--surface);border-radius:6px;padding:6px 8px;font-size:13px;min-width:0;width:100%}
.task select.s-done{color:var(--done);font-weight:700;background:var(--done-soft)}
.task select.s-prog{color:var(--prog);font-weight:700;background:var(--prog-soft)}
.task input.overdue{border-color:var(--late);color:var(--late)}
.rm{border:0;background:none;color:var(--muted);font-size:12px;padding:4px 6px;border-radius:6px}
.rm:hover{color:var(--late);background:var(--late-soft)}
@media (max-width:600px){.task{grid-template-columns:1fr 1fr;padding-bottom:8px;border-bottom:1px dashed var(--line)}.task .tn{grid-column:1/-1;grid-row:1}.task .rm{justify-self:end}}
.addf{display:flex;gap:8px;flex-wrap:wrap}
.addf input{flex:1 1 220px;min-width:0;border:1px dashed var(--line);background:var(--surface);border-radius:6px;padding:7px 10px}
.dfoot{display:flex;justify-content:space-between;flex-wrap:wrap;gap:10px;border-top:1px solid var(--line);padding-top:14px}

/* Summary */
.grid-top{display:grid;grid-template-columns:minmax(0,1.05fr) minmax(0,1.5fr) minmax(0,1fr);gap:16px}
@media (max-width:980px){.grid-top{grid-template-columns:1fr 1fr}.grid-top .due{grid-column:1/-1}}
@media (max-width:640px){.grid-top{grid-template-columns:1fr}}
.overall{display:flex;flex-direction:column;gap:16px}
.ringrow{display:flex;gap:18px;align-items:center}
.ring{flex:none} .ring text{fill:var(--ink)}
.ringlbl{font-size:13px;color:var(--muted)} .ringlbl b{display:block;color:var(--ink);font-size:15px}
.counts{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.cnt{background:var(--sunk);border-radius:8px;padding:9px 11px;display:flex;flex-direction:column;gap:2px}
.cnt .v{font-family:var(--f-num);font-size:20px;font-weight:600;line-height:1.1}
.cnt .k{font-size:12px;color:var(--muted);display:flex;align-items:center;gap:6px}
.obars{display:flex;flex-direction:column;gap:13px}
.ob{display:grid;grid-template-columns:auto minmax(0,1fr) auto;gap:4px 10px;align-items:center;border:0;background:none;padding:0;text-align:left;width:100%}
.ob .tag{font-family:var(--f-num);font-size:12px;font-weight:600;color:var(--oc,var(--accent));width:26px}
.ob .nm{font-size:13px;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.ob:hover .nm{color:var(--accent)}
.ob .pc{font-family:var(--f-num);font-weight:600;font-size:13px;text-align:right}
.ob .bar{grid-column:2/4}
.ob .meta{grid-column:2/4;font-size:11.5px;color:var(--muted)}
.legend{display:flex;gap:14px;flex-wrap:wrap;font-size:12px;color:var(--muted);margin-top:14px}
.legend span{display:flex;align-items:center;gap:6px}
