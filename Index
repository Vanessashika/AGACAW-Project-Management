<body>

<header class="masthead pad">
  <div class="inner top">
    <div>
      <div class="eyebrow">Advancing Community Agency and Accountability</div>
      <h1>WASH and Livelihood Project</h1>
      <div class="sub">Savelugu · Walewale · Kpong-Tamale · small towns, northern Ghana</div>
    </div>
    <div class="actions">
      <button class="btn primary" type="button" data-report>PDF report</button>
      <button class="btn" id="exportBtn" type="button">Export data</button>
      <button class="btn" id="importBtn" type="button">Import data</button>
      <input type="file" id="importFile" accept="application/json,.json" hidden>
      <button class="btn warn" id="clearBtn" type="button">Clear progress</button>
    </div>
  </div>
</header>
<nav class="tabbar pad" aria-label="Sections">
  <div class="inner tabs" id="tabs" role="tablist"></div>
</nav>
<main class="pad">
  <div class="inner view">
    <div class="note" id="sampleNote" hidden>
      <span><b>Example progress shown.</b> Task statuses and dates are made up so you can see how the tracker behaves. Your changes save in this browser.</span>
      <button class="btn" id="clearBtn2" type="button">Start real tracking</button>
    </div>
    <div id="view" class="view"></div>
    <div class="foot">Task progress: Done = 100%, In progress = 50%, Not started = 0%. Activity % is the task average; outcome and overall % average the activities.</div>
  </div>
</main>

<div id="report" class="report"></div>

<script>
// ---------- Seed data (from the programme results framework) ----------
// [name, location, partner, start, end, example statuses (D/I/N), tasks]
const SEED = [
 {short:"Planning & finance", name:"WASH Master Planning, Monitoring & Resource Mobilisation", acts:[
  ["WASH infrastructure mapping & digital water security monitoring","All areas","CWSA","2026-03-01","2027-03-31","DDINN",["Design data collection tools","GIS mapping of water assets","Set up monitoring platform","Train staff on the platform","First water security monitoring report"]],
  ["Project baseline assessment","Savelugu, Walewale","Programme team","2026-02-01","2026-07-31","DDDDD",["Define baseline indicators","Design survey tools","Field data collection","Data analysis","Validated baseline report"]],
  ["Data collection, stakeholder engagement & plan development","Savelugu, Walewale","Municipal assemblies","2026-04-01","2027-02-28","DDINN",["Stakeholder mapping","Community and institutional consultations","Draft WASH plan","Validation workshop","Plan adopted by assemblies"]],
  ["General Assembly engagement & leadership training","Savelugu, Walewale","Municipal assemblies","2026-09-01","2027-06-30","DINN",["Training needs assessment","Develop training modules","Deliver leadership sessions","Post-training evaluation"]],
  ["Municipal revenue assessment","Savelugu, Walewale","Municipal finance units","2026-06-01","2026-12-15","DDIN",["Review revenue data","Interviews with finance units","Revenue gap analysis","Revenue assessment report"]],
  ["Municipal revenue improvement & sanitation financing","Savelugu, Walewale","Municipal finance units","2027-01-01","2027-12-31","NNNN",["Develop revenue improvement plan","Pilot improvement measures","Sanitation financing options study","Track revenue change"]]
 ]},
 {short:"Infrastructure", name:"Robust WASH Infrastructure for Schools and Communities", acts:[
  ["Expand water services in Walewale and Savelugu","Savelugu, Walewale","GWL / CWSA","2026-05-01","2027-12-31","DINNN",["Feasibility and design","Procurement of contractors","Construction works","New connections made","Commissioning and handover"]],
  ["Water system optimisation in Kpong Tamale","Tamale","GWL","2026-07-01","2027-06-30","DINN",["System performance audit","Optimisation plan","Works and equipment installation","Post-optimisation performance test"]],
  ["Develop new water infrastructure in small towns","Small towns","CWSA","2027-01-01","2028-06-30","INNNN",["Site selection","Hydrogeological studies","Engineering design","Drilling and construction","Handover to operators"]],
  ["Provide WASH in schools infrastructure","Savelugu, Walewale","Education directorates","2026-10-01","2027-10-31","INNNN",["School selection","Needs assessment per school","Facility design","Construction","Handover to schools"]],
  ["Strengthen capacity of school WASH committees","Savelugu, Walewale","Schools","2027-01-01","2027-12-31","NNNN",["Form or revive committees","Committee training","O&M plans per school","Follow-up monitoring visits"]]
 ]},
 {short:"Sanitation markets", name:"Established sanitation markets for affordable and sustainable sanitation services", acts:[
  ["Set up and support sanitation artisans co-op for small towns","Small towns","Artisans / municipalities","2026-11-01","2027-06-30","INNN",["Identify artisans","Mobilise and register co-op","Set up co-op governance","Co-op business plan"]],
  ["Market assessment of sanitation service delivery","Savelugu, Walewale","Programme team","2026-07-01","2026-12-31","DDDIN",["Inception report","Field data collection","Data analysis","Validation workshop","Final assessment report"]],
  ["Conduct sanitation marketing campaigns","Savelugu, Walewale","Municipal EHUs","2027-02-01","2027-12-31","NNNN",["Formative research","Campaign design and materials","Campaign rollout","Measure toilet uptake"]],
  ["Train sanitation artisans and support sanitation businesses","Small towns","Artisans co-op","2027-01-01","2027-09-30","NNNN",["Skills gap assessment","Technical and business training","Link businesses to finance","Track sales and installations"]],
  ["Review regulation and strengthen environmental health units","Savelugu, Walewale","Municipal EHUs","2026-09-01","2027-05-31","DINN",["Review sanitation bylaws","Regulatory gap analysis","Recommendations to assemblies","EHU staff training"]]
 ]},
 {short:"Utility & governance", name:"Utility capacity and WASH governance systems for inclusive and accountable water services", acts:[
  ["Refine and scale SoPs, and commercial department support with CWSA","All areas","CWSA","2026-04-01","2027-04-30","DDIN",["Review existing SoPs","Revise SoPs","Train commercial staff","Roll out to more systems"]],
  ["Improve asset management and inventory system with CWSA","All areas","CWSA","2026-08-01","2027-06-30","DINN",["Asset audit","Set up inventory system","Data entry and verification","Staff training"]],
  ["Low income customer support provision with GWL in Savelugu","Savelugu","GWL","2026-09-01","2027-09-30","INNN",["Identify low-income customers","Design support model","Implement support","Track new connections"]],
  ["Regulation support for water services in small towns","Small towns","CWSA / regulators","2027-01-01","2027-10-31","NNN",["Review regulatory framework","Stakeholder consultations","Draft guidelines"]],
  ["Research on small-town water service provision and workshops","Small towns","Programme team","2026-10-01","2027-08-31","INN",["Research design","Conduct study","Dissemination workshops"]]
 ]},
 {short:"Gender & community", name:"Enhanced Female Leadership and Community Rights in WASH service provision", acts:[
  ["Skill gap analysis and training for female staff of CWSA and municipalities","All areas","CWSA / municipalities","2026-08-01","2027-06-30","DINN",["Skills gap analysis","Training plan","Deliver training","Mentorship and follow-up"]],
  ["Strengthen gender mainstreaming guidelines for municipal WASH planning","Savelugu, Walewale","Municipal assemblies","2026-10-01","2027-06-30","INNN",["Review existing guidelines","Revise guidelines","Validation","Adopt in municipal plans"]],
  ["Strengthen community engagement and municipal responsiveness","Savelugu, Walewale","Municipal assemblies","2026-07-01","2027-12-31","DINN",["Set up feedback mechanisms","Community forums","Track complaints resolved","Annual responsiveness review"]]
 ]}
];
const SAMPLE_RESULTS = {
  "Project baseline assessment":"Baseline survey completed in both municipalities. Validated report shared with assemblies.",
  "Market assessment of sanitation service delivery":"Fieldwork done in Savelugu and Walewale. Analysis finished; validation workshop being planned.",
  "Refine and scale SoPs, and commercial department support with CWSA":"Revised SoPs drafted and commercial staff trained."
};
const LOCS = ["Savelugu","Walewale","Savelugu, Walewale","Tamale","Small towns","All areas"];
const KEY = "wash-tracker-v1";
const STATUS = {N:"todo", I:"prog", D:"done"};
const SLABEL = {todo:"Not started", prog:"In progress", done:"Done"};

const nid = p => p + Date.now().toString(36) + Math.random().toString(36).slice(2,7);
const toD = s => new Date(s + "T00:00:00");
const iso = d => { const z = new Date(d); z.setMinutes(z.getMinutes()-z.getTimezoneOffset()); return z.toISOString().slice(0,10) };

function buildSeed(withProgress){
  return { sample: withProgress, outcomes: SEED.map((o,oi) => ({
    id:"O"+(oi+1), short:o.short, name:o.name,
    acts:o.acts.map(([name,loc,partner,start,end,pat,tasks]) => {
      const s = toD(start), e = toD(end), span = e - s;
      return { id:nid("a"), name, loc, partner, owner:"", start, end,
        results: withProgress ? (SAMPLE_RESULTS[name]||"") : "",
        tasks:tasks.map((t,i) => ({ id:nid("t"), name:t,
          status: withProgress ? STATUS[pat[i]||"N"] : "todo",
          due: iso(new Date(s.getTime() + span*(i+1)/tasks.length)) })) };
    })
  }))};
}
function load(){ try{ const r = localStorage.getItem(KEY); return r ? JSON.parse(r) : null }catch(e){ return null } }
function save(){ try{ localStorage.setItem(KEY, JSON.stringify(state)) }catch(e){} }
let state = load() || buildSeed(true);
// fill fields that older saved data may not have
state.outcomes.forEach((o,i) => { o.short = o.short || SEED[i]?.short || ("Outcome " + (i+1)); o.acts.forEach(a => { a.results = a.results || "" }) });

const today = new Date(); today.setHours(0,0,0,0);
const h = s => String(s ?? "").replace(/[&<>"']/g, c => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
const fmt = d => d ? toD(d).toLocaleDateString("en-GB",{day:"numeric",month:"short",year:"numeric"}) : "—";
const fmtShort = d => toD(d).toLocaleDateString("en-GB",{day:"numeric",month:"short"});

// ---------- Calculations ----------
const score = t => t.status==="done" ? 1 : t.status==="prog" ? .5 : 0;
const isLate = t => t.status!=="done" && t.due && toD(t.due) < today;
const actPct = a => a.tasks.length ? Math.round(a.tasks.reduce((s,t)=>s+score(t),0)/a.tasks.length*100) : 0;
function actStatus(a){ const p = actPct(a); return p===100 ? "done" : p===0 && !a.tasks.some(t=>t.status==="prog") ? "todo" : "prog" }
const lateCount = a => a.tasks.filter(isLate).length;
const avg = arr => arr.length ? Math.round(arr.reduce((s,x)=>s+x,0)/arr.length) : 0;
const outPct = o => avg(o.acts.map(actPct));
const allActs = () => state.outcomes.flatMap(o => o.acts.map(a => ({a,o})));
function taskSplit(ts){ const n = ts.length||1, d = ts.filter(t=>t.status==="done").length, p = ts.filter(t=>t.status==="prog").length; return {n:ts.length,d,p,dw:d/n*100,pw:p/n*100} }
const barHTML = ts => { const s = taskSplit(ts); return `<div class="bar"><div class="d" style="width:${s.dw}%"></div><div class="p" style="width:${s.pw}%"></div></div>` };
function chipHTML(a){ const late = lateCount(a), st = actStatus(a);
  return late ? `<span class="st late">${late} overdue</span>` : `<span class="st ${st}">${st==="done"?"Complete":SLABEL[st]}</span>` }

// ---------- Routing: #o1 … #o5, #summary ----------
const ui = { tab:"home", sel:{}, adding:false, subOpen:{} };
function readHash(){
  const k = (location.hash||"").slice(1);
  if(k==="summary" || k==="home" || /^o\d+$/.test(k) && state.outcomes[+k.slice(1)-1]) ui.tab = k; else ui.tab = "home";
}
function go(tab, actId){
  ui.tab = tab; ui.adding = false;
  if(actId){ const oi = +tab.slice(1)-1; ui.sel[state.outcomes[oi].id] = actId }
  try{ if(location.hash !== "#"+tab) history.replaceState(null,"","#"+tab) }catch(e){}
  render();
  const el = actId && document.getElementById("item-"+actId);
  if(el) el.scrollIntoView({block:"start"}); else window.scrollTo({top:0});
}
window.addEventListener("hashchange", () => { readHash(); render() });

// ---------- Tabs ----------
function renderTabs(){
  const home = `<button class="tab home" role="tab" type="button" data-tab="home" aria-selected="${ui.tab==="home"}"><span class="tk">Start</span><span class="tl"><svg width="14" height="14" viewBox="0 0 16 16" aria-hidden="true"><path d="M2 7.5 8 2.5l6 5V14H10v-4H6v4H2z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>Home</span></button>`;
  const t = home + state.outcomes.map((o,i) => { const k="o"+(i+1), p = outPct(o);
    return `<button class="tab" style="--oc:var(--o${(i%5)+1})" role="tab" type="button" data-tab="${k}" aria-selected="${ui.tab===k}">
      <span class="tk">Outcome ${i+1}</span><span class="tl">${h(o.short)}</span>
      <span class="tp"><span class="mini"><i style="width:${p}%"></i></span>${p}%</span></button>` }).join("");
  const all = avg(allActs().map(x=>actPct(x.a)));
  document.getElementById("tabs").innerHTML = t + `<button class="tab sum" role="tab" type="button" data-tab="summary" aria-selected="${ui.tab==="summary"}">
      <span class="tk">Overview</span><span class="tl">Summary &amp; results</span>
      <span class="tp"><span class="mini"><i style="width:${all}%"></i></span>${all}%</span></button>`;
}

