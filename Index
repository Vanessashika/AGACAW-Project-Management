  document.querySelector(".masthead").hidden = isHome;
  document.querySelector(".tabbar").hidden = isHome;
  document.querySelector(".foot").hidden = isHome;
  document.getElementById("sampleNote").hidden = !state.sample || isHome;
  document.body.classList.toggle("is-home", isHome);
  renderTabs();
  const v = document.getElementById("view");
  v.style.setProperty("--oc", /^o\d+$/.test(ui.tab) ? `var(--o${((+ui.tab.slice(1)-1)%5)+1})` : "var(--accent)");
  v.innerHTML = ui.tab==="summary" ? summaryView() : ui.tab==="home" ? homeView() : outcomeView(+ui.tab.slice(1)-1);
  if(!document.getElementById("locs")){ const dl = document.createElement("datalist"); dl.id="locs"; dl.innerHTML = LOCS.map(l=>`<option value="${l}">`).join(""); document.body.appendChild(dl) }
}
// light refresh after a field edit: tabs, outcome header and the edited row's header; the open body (and focus) stays
function refreshAround(aid){
  renderTabs();
  if(ui.tab==="summary") return;
  const oi = +ui.tab.slice(1)-1, o = state.outcomes[oi];
  const tmp = document.createElement("div"); tmp.innerHTML = outcomeView(oi);
  const head = document.querySelector(".ohead"); if(head) head.replaceWith(tmp.querySelector(".ohead"));
  const a = aid && o.acts.find(x=>x.id===aid);
  const ih = a && document.querySelector(`[data-toggle="${aid}"]`);
  if(ih){ const t2 = document.createElement("div"); t2.innerHTML = headHTML(o,a); ih.replaceWith(t2.firstElementChild) }
}

// ---------- Events ----------
const findA = id => allActs().find(x=>x.a.id===id);
function toast(msg){ const t = document.createElement("div"); t.className="toast"; t.textContent=msg; document.body.appendChild(t); setTimeout(()=>t.remove(),2400) }
function edited(){ if(state.sample){ /* keep sample flag until cleared */ } save() }

document.addEventListener("click", e => {
  const tab = e.target.closest("[data-tab]"); if(tab){ go(tab.dataset.tab); return }
  const tg = e.target.closest("[data-toggle]");
  if(tg){ const {o} = findA(tg.dataset.toggle); ui.sel[o.id] = ui.sel[o.id]===tg.dataset.toggle ? null : tg.dataset.toggle; ui.adding = false; render();
    if(ui.sel[o.id]){ const el = document.getElementById("item-"+tg.dataset.toggle); const r = el.getBoundingClientRect(); if(r.top < 90 || r.top > innerHeight*.6) el.scrollIntoView({behavior:"smooth",block:"start"}) } return }
  const goto = e.target.closest("[data-goto]");
  if(goto){ const {o} = findA(goto.dataset.goto); go("o"+(state.outcomes.indexOf(o)+1), goto.dataset.goto); return }
  if(e.target.closest("#addActBtn")){ ui.adding = true; render(); document.getElementById("acc")?.scrollIntoView({behavior:"smooth",block:"start"}); document.getElementById("na-name")?.focus(); return }
  if(e.target.closest("#cancelAdd")){ ui.adding = false; render(); return }
  const rmt = e.target.closest("[data-rmt]");
  if(rmt){ const {a} = findA(rmt.dataset.a); a.tasks = a.tasks.filter(t=>t.id!==rmt.dataset.rmt); edited(); render(); toast("Task removed"); return }
  const rma = e.target.closest("[data-rma]");
  if(rma){
    if(!rma.dataset.armed){ rma.dataset.armed="1"; rma.textContent="Click again to delete"; setTimeout(()=>{ if(rma.isConnected){ delete rma.dataset.armed; rma.textContent="Delete activity" } },4000); return }
    const {a,o} = findA(rma.dataset.rma); o.acts = o.acts.filter(x=>x!==a); ui.sel[o.id] = null; edited(); render(); toast("Activity deleted"); return }
});
document.addEventListener("change", e => {
  const el = e.target; if(!el.dataset.a) return;
  const {a} = findA(el.dataset.a) || {}; if(!a) return;
  if(el.classList.contains("ts")){ a.tasks.find(t=>t.id===el.dataset.t).status = el.value; edited(); render(); return }
  if(el.classList.contains("tn")){ const t = a.tasks.find(t=>t.id===el.dataset.t); t.name = el.value.trim() || t.name }
  if(el.classList.contains("td")){ const t = a.tasks.find(t=>t.id===el.dataset.t); t.due = el.value; el.classList.toggle("overdue", isLate(t)) }
  const f = el.dataset.f;
  if(f){ const v = el.value.trim(); if(f==="name" && !v) { el.value = a.name; return } if((f==="start"||f==="end") && !v) return; a[f] = v }
  edited(); refreshAround(a.id);
});
document.addEventListener("submit", e => {
  e.preventDefault();
  if(e.target.id==="addTask"){ const {a} = findA(e.target.dataset.a), v = e.target.task.value.trim(); if(!v) return;
    a.tasks.push({id:nid("t"), name:v, status:"todo", due:a.end}); edited(); render(); document.getElementById("add-"+a.id)?.focus(); return }
  if(e.target.id==="addAct"){ const f = e.target, o = state.outcomes.find(x=>x.id===f.dataset.o);
    const name = f.name.value.trim(), start = f.start.value, end = f.end.value;
    if(!name){ toast("Give the activity a name."); return }
    if(!start || !end || end < start){ toast("Set an end date on or after the start date."); return }
    const lines = f.tasks.value.split("\n").map(s=>s.trim()).filter(Boolean), s = toD(start), span = toD(end)-s;
    const a = { id:nid("a"), name, loc:f.loc.value.trim()||"All areas", partner:f.partner.value.trim()||"—", owner:f.owner.value.trim(), start, end, results:"",
      tasks: lines.map((t,i)=>({id:nid("t"), name:t, status:"todo", due:iso(new Date(s.getTime()+span*(i+1)/lines.length))})) };
    o.acts.push(a); ui.sel[o.id] = a.id; ui.adding = false; edited(); render(); toast("Activity added"); return }
});

document.addEventListener("toggle", e => { const d = e.target; if(d.dataset && d.dataset.sub) ui.subOpen[d.dataset.sub] = d.open }, true);

// ---------- PDF progress report (browser print → Save as PDF) ----------
const PROJECT = "Advancing Community Agency and Accountability WASH and Livelihood Project";
// --- report charts (SVG, print colours) ---
const RC = {ink:"#0f1e36",muted:"#5f6f88",line:"#d6dfec",grid:"#e6ecf4",done:"#1e4f8f",prog:"#93b8e6",todo:"#e4eaf3",late:"#c0453a",o:["#0f2f5c","#1e4f8f","#2f6fbf","#3a78c2","#5590d2"]};
const FONT = `font-family="Manrope, Helvetica, Arial, sans-serif"`, MONO = `font-family="IBM Plex Mono, Menlo, monospace"`;
const tr = (s,n) => { s = String(s); return s.length>n ? s.slice(0,n-1).trimEnd()+"…" : s };
function donutSVG(parts, big, small){
  const R = 52, C = 2*Math.PI*R, tot = parts.reduce((a,p)=>a+p.v,0)||1; let acc = 0;
  const arcs = parts.map(p => { const len = p.v/tot*C, el = `<circle cx="70" cy="70" r="${R}" fill="none" stroke="${p.c}" stroke-width="16" stroke-dasharray="${len} ${C-len}" stroke-dashoffset="${-acc}" transform="rotate(-90 70 70)"/>`; acc += len; return el }).join("");
  return `<svg viewBox="0 0 140 140" width="132" height="132"><circle cx="70" cy="70" r="${R}" fill="none" stroke="${RC.todo}" stroke-width="16"/>${arcs}
    <text x="70" y="72" text-anchor="middle" ${MONO} font-size="22" font-weight="500" fill="${RC.ink}">${big}</text>
    <text x="70" y="89" text-anchor="middle" ${FONT} font-size="9" fill="${RC.muted}">${small}</text></svg>`;
}
const legend = items => `<div class="rleg">${items.map(([c,l])=>`<span><i style="background:${c}"></i>${l}</span>`).join("")}</div>`;
function outcomeBarsSVG(){
  const W = 680, L = 190, R = 60, bw = W-L-R, rh = 38, top = 22, H = top + state.outcomes.length*rh + 6;
  let g = [0,25,50,75,100].map(v => { const x = L + bw*v/100; return `<line x1="${x}" y1="${top-6}" x2="${x}" y2="${H-4}" stroke="${RC.grid}"/><text x="${x}" y="12" text-anchor="middle" ${MONO} font-size="9" fill="${RC.muted}">${v}%</text>` }).join("");
  state.outcomes.forEach((o,i) => { const sp = taskSplit(o.acts.flatMap(a=>a.tasks)), y = top + i*rh, n = sp.n||1, wd = bw*sp.d/n, wp = bw*sp.p/n, pc = outPct(o);
    g += `<rect x="${L-178}" y="${y+6}" width="4" height="22" rx="2" fill="${RC.o[i%5]}"/>
      <text x="${L-168}" y="${y+16}" ${FONT} font-size="11" font-weight="700" fill="${RC.ink}">Outcome ${i+1}</text>
      <text x="${L-168}" y="${y+29}" ${FONT} font-size="10" fill="${RC.muted}">${h(tr(o.short,26))}</text>
      <rect x="${L}" y="${y+9}" width="${bw}" height="16" rx="3" fill="${RC.todo}"/>
      <rect x="${L}" y="${y+9}" width="${wd}" height="16" rx="3" fill="${RC.done}"/>
      <rect x="${L+wd}" y="${y+9}" width="${wp}" height="16" fill="${RC.prog}"/>
      <text x="${W-R+10}" y="${y+21}" ${MONO} font-size="12" font-weight="600" fill="${RC.ink}">${pc}%</text>` });
  return `<svg viewBox="0 0 ${W} ${H}" width="100%">${g}</svg>`;
}
function ganttSVG(){
  const acts = allActs(); if(!acts.length) return "";
  const min = new Date(Math.min(...acts.map(x=>toD(x.a.start)))); min.setDate(1); min.setMonth(Math.floor(min.getMonth()/3)*3);
  const max = new Date(Math.max(...acts.map(x=>toD(x.a.end)))); max.setMonth(Math.floor(max.getMonth()/3)*3+3,1);
  const W = 680, L = 250, bw = W-L-6, rh = 15, oh = 20, top = 22, x = d => L + bw*Math.max(0,Math.min(1,(d-min)/(max-min)));
  let y = top, rows = "";
  state.outcomes.forEach((o,i) => {
    rows += `<text x="0" y="${y+14}" ${FONT} font-size="9" font-weight="700" letter-spacing="1" fill="${RC.o[i%5]}">OUTCOME ${i+1} · ${h(o.short.toUpperCase())}</text>`; y += oh;
    o.acts.forEach(a => { const x1 = x(toD(a.start)), x2 = x(toD(a.end)), w = Math.max(2,x2-x1), p = actPct(a);
      rows += `<text x="8" y="${y+10}" ${FONT} font-size="8.5" fill="${RC.ink}">${h(tr(a.name,52))}</text>
        <rect x="${x1}" y="${y+2}" width="${w}" height="10" rx="2" fill="${RC.todo}"/>
        <rect x="${x1}" y="${y+2}" width="${w*p/100}" height="10" rx="2" fill="${RC.o[i%5]}"/>`; y += rh });
  });
  const H = y + 6; let ax = "";
  for(let d = new Date(min); d < max; d.setMonth(d.getMonth()+3)){ const xx = x(d);
    ax += `<line x1="${xx}" y1="${top-4}" x2="${xx}" y2="${H}" stroke="${RC.grid}"/><text x="${xx+3}" y="12" ${MONO} font-size="8.5" fill="${RC.muted}">Q${d.getMonth()/3+1} ${String(d.getFullYear()).slice(2)}</text>` }
  const tx = today>=min && today<=max ? `<line x1="${x(today)}" y1="${top-4}" x2="${x(today)}" y2="${H}" stroke="${RC.late}" stroke-width="1.2" stroke-dasharray="3 2"/><text x="${x(today)}" y="${H+10}" text-anchor="middle" ${FONT} font-size="8" font-weight="700" fill="${RC.late}">Today</text>` : "";
  return `<svg viewBox="0 0 ${W} ${H+14}" width="100%">${ax}${rows}${tx}</svg>`;
}
function actBarsSVG(o,i){
  const W = 680, L = 330, R = 50, bw = W-L-R, rh = 22, H = o.acts.length*rh + 4;
  return `<svg viewBox="0 0 ${W} ${H}" width="100%">${o.acts.map((a,k) => { const y = k*rh, sp = taskSplit(a.tasks), n = sp.n||1, lt = lateCount(a);
    return `<text x="0" y="${y+14}" ${FONT} font-size="9.5" fill="${RC.ink}">${h(tr(a.name,58))}</text>
      <rect x="${L}" y="${y+6}" width="${bw}" height="10" rx="2" fill="${RC.todo}"/>
      <rect x="${L}" y="${y+6}" width="${bw*sp.d/n}" height="10" rx="2" fill="${RC.o[i%5]}"/>
      <rect x="${L+bw*sp.d/n}" y="${y+6}" width="${bw*sp.p/n}" height="10" fill="${RC.prog}"/>
      <text x="${W-R+8}" y="${y+15}" ${MONO} font-size="10" font-weight="600" fill="${lt?RC.late:RC.ink}">${actPct(a)}%</text>` }).join("")}</svg>`;
}

function reportHTML(){
  const acts = allActs(), overall = avg(acts.map(x=>actPct(x.a))), ts = acts.flatMap(x=>x.a.tasks), sp = taskSplit(ts);
  const lateList = [], soon = [], horizon = new Date(today); horizon.setDate(horizon.getDate()+60);
  acts.forEach(({a,o}) => a.tasks.forEach(t => { if(t.status==="done"||!t.due) return; const d = toD(t.due);
    if(d<today) lateList.push({t,a,o,d}); else if(d<=horizon) soon.push({t,a,o,d}) }));
  lateList.sort((x,y)=>x.d-y.d); soon.sort((x,y)=>x.d-y.d);
  const pb = p => `<span class="pb"><i style="width:${p}%"></i></span>`;
  const dateStr = today.toLocaleDateString("en-GB",{day:"numeric",month:"long",year:"numeric"});
  const taskRows = list => list.map(x=>`<tr><td>${h(x.t.name)}</td><td class="muted">${h(x.o.id)} · ${h(x.a.name)}</td><td>${h(x.a.owner||"—")}</td><td class="n">${fmt(x.t.due)}</td></tr>`).join("");
  return `
  <div class="rk">Progress report · ${dateStr}</div>
  <h1>${h(PROJECT)}</h1>
  <div class="rmeta">Savelugu · Walewale · Kpong-Tamale · small towns, northern Ghana</div>
  <div class="rstats">
    <div><b>${overall}%</b><span>overall complete</span></div>
    <div><b>${acts.filter(x=>actStatus(x.a)==="done").length}/${acts.length}</b><span>activities complete</span></div>
    <div><b>${sp.d}/${sp.n}</b><span>tasks done</span></div>
    <div><b>${sp.p}</b><span>tasks in progress</span></div>
    <div><b style="${lateList.length?"color:#c0453a":""}">${lateList.length}</b><span>tasks overdue</span></div>
  </div>

  <div class="rcharts">
    <figure>${donutSVG([{v:overall,c:RC.done}],overall+"%","overall complete")}<figcaption>Overall progress</figcaption></figure>
    <figure>${donutSVG([{v:sp.d,c:RC.done},{v:sp.p,c:RC.prog}],sp.n,"tasks")}<figcaption>Task status</figcaption>${legend([[RC.done,`Done ${sp.d}`],[RC.prog,`In progress ${sp.p}`],[RC.todo,`Not started ${sp.n-sp.d-sp.p}`]])}</figure>
    <figure>${(()=>{ const by={done:0,prog:0,todo:0}; acts.forEach(x=>by[actStatus(x.a)]++); return donutSVG([{v:by.done,c:RC.done},{v:by.prog,c:RC.prog}],acts.length,"activities") + `<figcaption>Activity status</figcaption>` + legend([[RC.done,`Complete ${by.done}`],[RC.prog,`In progress ${by.prog}`],[RC.todo,`Not started ${by.todo}`]]) })()}</figure>
  </div>

  <h2>Progress by outcome</h2>
  <div class="rfig">${outcomeBarsSVG()}${legend([[RC.done,"Done"],[RC.prog,"In progress"],[RC.todo,"Not started"]])}</div>
  <table class="keep"><thead><tr><th>Outcome</th><th>Progress</th><th style="text-align:right">Activities done</th><th style="text-align:right">Tasks done</th><th style="text-align:right">Overdue</th></tr></thead><tbody>
  ${state.outcomes.map((o,i)=>{ const s2 = taskSplit(o.acts.flatMap(a=>a.tasks)), lt = o.acts.reduce((n,a)=>n+lateCount(a),0), p = outPct(o);
    return `<tr><td><b>${i+1}. ${h(o.short)}</b><br><span class="muted">${h(o.name)}</span></td><td style="white-space:nowrap">${pb(p)}<b>${p}%</b></td>
      <td class="n">${o.acts.filter(a=>actStatus(a)==="done").length}/${o.acts.length}</td><td class="n">${s2.d}/${s2.n}</td><td class="n ${lt?"late":""}">${lt}</td></tr>` }).join("")}
  </tbody></table>

  <h2>Schedule</h2>
  <div class="rfig rgantt">${ganttSVG()}<div class="rcap">Bar = planned start to end · fill = % complete · dashed red line = today</div></div>

  <h2 class="pbreak">Activity status</h2>
  ${state.outcomes.map((o,i)=>`<div class="rob"><h3><span>Outcome ${i+1}: ${h(o.short)}</span><span>${outPct(o)}%</span></h3>
    <div class="rfig small">${actBarsSVG(o,i)}</div>
    <table><thead><tr><th>Activity</th><th>Location</th><th>Lead</th><th>Status</th><th style="text-align:right">Progress</th></tr></thead><tbody>
    ${o.acts.map(a=>{ const lt = lateCount(a), st = actStatus(a);
      return `<tr><td>${h(a.name)}<br><span class="muted">${fmt(a.start)} – ${fmt(a.end)}</span></td><td>${h(a.loc)}</td><td>${h(a.owner||"—")}</td>
      <td>${st==="done"?"Complete":SLABEL[st]}${lt?`<br><span class="late">${lt} overdue</span>`:""}</td><td class="n">${actPct(a)}%</td></tr>` }).join("") || `<tr><td colspan="5" class="muted">No activities.</td></tr>`}
    </tbody></table></div>`).join("")}

  <h2>Overdue tasks</h2>
  ${lateList.length ? `<table><thead><tr><th>Task</th><th>Activity</th><th>Lead</th><th style="text-align:right">Was due</th></tr></thead><tbody>${taskRows(lateList)}</tbody></table>` : `<p class="muted">No overdue tasks.</p>`}

  <h2>Due in the next 60 days</h2>
  ${soon.length ? `<table><thead><tr><th>Task</th><th>Activity</th><th>Lead</th><th style="text-align:right">Due</th></tr></thead><tbody>${taskRows(soon)}</tbody></table>` : `<p class="muted">Nothing due in the next 60 days.</p>`}

  <h2>Results recorded</h2>
  ${acts.some(x=>x.a.results) ? `<table><thead><tr><th style="width:38%">Activity</th><th>Results &amp; notes</th></tr></thead><tbody>
    ${acts.filter(x=>x.a.results).map(x=>`<tr><td><b>${h(x.a.name)}</b><br><span class="muted">Outcome ${state.outcomes.indexOf(x.o)+1}: ${h(x.o.short)}</span></td><td class="res">${h(x.a.results)}</td></tr>`).join("")}</tbody></table>`
    : `<p class="muted">No results recorded yet.</p>`}

  <div class="rfoot">Task progress: Done = 100%, In progress = 50%, Not started = 0%. Activity % is the task average; outcome and overall % average the activities.${state.sample?" This report uses example data.":""}</div>`;
}
function fillReport(){ document.getElementById("report").innerHTML = reportHTML() }
window.addEventListener("beforeprint", fillReport);
document.addEventListener("click", e => {
  if(!e.target.closest("[data-report]")) return;
  fillReport();
  toast("Opening print dialog. Choose “Save as PDF” as the printer.");
  setTimeout(() => { try{ window.print() }catch(err){} }, 300);
});

// Clear progress: two-click confirm
function armClear(btn){
  if(btn.dataset.armed){ state = buildSeed(false); save(); ui.sel = {}; render(); toast("Progress cleared. Activities and tasks kept."); return }
  const old = btn.textContent; btn.dataset.armed = "1"; btn.textContent = "Click again to confirm";
  setTimeout(()=>{ delete btn.dataset.armed; btn.textContent = old }, 4000);
}
document.getElementById("clearBtn").onclick = e => armClear(e.currentTarget);
document.getElementById("clearBtn2").onclick = e => armClear(e.currentTarget);

// Export / import as JSON
document.getElementById("exportBtn").onclick = async () => {
  const json = JSON.stringify(state, null, 2);
  try{ const url = URL.createObjectURL(new Blob([json],{type:"application/json"}));
    const a = document.createElement("a"); a.href = url; a.download = "wash-tracker-" + iso(new Date()) + ".json";
    document.body.appendChild(a); a.click(); a.remove(); setTimeout(()=>URL.revokeObjectURL(url),1000) }catch(err){}
  try{ await navigator.clipboard.writeText(json); toast("Data exported (also copied to clipboard)") }catch(err){ toast("Download started") }
};
document.getElementById("importBtn").onclick = () => document.getElementById("importFile").click();
document.getElementById("importFile").onchange = e => {
  const f = e.target.files[0]; if(!f) return; const r = new FileReader();
  r.onload = () => { try{ const d = JSON.parse(r.result); if(!Array.isArray(d.outcomes)) throw 0; state = d;
      state.outcomes.forEach((o,i)=>{ o.short = o.short || SEED[i]?.short || ("Outcome "+(i+1)); o.acts.forEach(a=>{ a.results = a.results||"" }) });
      save(); ui.sel = {}; render(); toast("Data imported") }
    catch(err){ toast("That file isn't a tracker export. Choose a .json file saved with Export data.") } };
  r.readAsText(f); e.target.value = "";
};

readHash(); render();
</script>
